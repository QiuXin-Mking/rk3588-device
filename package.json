{
  "name": "rk3588-device-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:device": "vite --mode device",
    "dev:mobile": "vite --mode mobile",
    "build": "pnpm build:device",
    "build:device": "tsc --noEmit -p tsconfig.app.json && vite build --mode device",
    "build:mobile": "tsc --noEmit -p tsconfig.app.json && vite build --mode mobile",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "biome lint frontend/src vite.config.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "test:server": "node --test tests/*.test.cjs",
    "admin:dev": "pnpm --filter @ego/management-web dev",
    "admin:build": "pnpm --filter @ego/management-web build",
    "admin:test": "pnpm --filter @ego/management-web test"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.3.0",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.2.7"
  }
}
